FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY scraper/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY scraper/dealio_scraper ./dealio_scraper
RUN useradd --system --uid 10001 --create-home scraper && chown -R scraper:scraper /app
USER scraper
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 CMD ["python", "-m", "dealio_scraper.healthcheck"]
CMD ["python", "-m", "dealio_scraper.worker"]
