# Copy to docker/.env and fill in values. Never commit docker/.env.

POSTGRES_DB=price_tracker_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-only-change-this-password

JWT_SECRET=local-only-development-secret-change-before-use-0123456789
INTERNAL_API_KEY=local-only-internal-key-change-before-use
HANGFIRE_DASHBOARD_API_KEY=local-only-dashboard-key-change-before-use

RABBITMQ_USER=price_tracker
RABBITMQ_PASSWORD=local-only-rabbitmq-password-change-before-use

ALLOWED_HOSTS=localhost;127.0.0.1
FRONTEND_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
CORS_ALLOWED_ORIGIN=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=local-only@example.invalid
SMTP_PASSWORD=local-only-smtp-password-change-before-use
SMTP_FROM=local-only@example.invalid

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Dealio

TAVILY_API_KEY=
TAVILY_MONTHLY_QUOTA=1000
TAVILY_MAX_RESULTS=20

CURRENCY_API_KEY=
CURRENCY_RATE_REFRESH_MINUTES=1440

VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
